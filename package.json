{
  "name": "plant-disease-severity-estimation",
  "version": "1.0.0",
  "description": "Agritech Self-Supervised Cross-Domain Vision Transformers for Fine-Grained Crop Leaf Disease Severity Estimation",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:server": "cd backend && npm run dev",
    "dev:client": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "test:predict": "cd backend && node test-predict.js",
    "test:suite": "cd backend && node test-suite.js",
    "test:parity": "cd backend && node verify-parity.js",
    "test:models": "python -c \"import ml_models; print('ML package functional')\"",
    "benchmark:models": "python -m ml_models.benchmark",
    "train:models": "python -c \"from ml_models.trainer import ModelTrainingSimulator; ModelTrainingSimulator('vit').train_and_evaluate(); ModelTrainingSimulator('cnn').train_and_evaluate()\"",
    "start:model": "cd backend && python model_service.py",
    "free:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue | ForEach-Object { if ($_.OwningProcess -gt 0) { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } }\""
  },
  "keywords": [
    "agritech",
    "vision-transformer",
    "crop-disease",
    "severity-estimation",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Agritech Research Team",
  "license": "ISC"
}

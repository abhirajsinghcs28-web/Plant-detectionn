PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/plant_disease_db
NODE_ENV=development

# AI Inference Configuration (Member 3 System Integration)
# Set to 'mock' for local UI development without AI model server
# Set to 'real' when Member 2's Python Vision Transformer inference service is running
AI_MODE=real
AI_INFERENCE_URL=http://localhost:8000/predict
AI_TIMEOUT_MS=15000
